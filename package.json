{
  "name": "splat-walk",
  "private": true,
  "version": "1.0.0",
  "description": "A first-person walk through a Gaussian splat scan of Artillery Passage, London, made to look like phone footage",
  "repository": "github:willeastcott/splat-walk",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "splat": "splat-transform",
    "splat:build": "node tools/build-scene.mjs",
    "splat:info": "splat-transform public/scene/lod-meta.json --info json null",
    "perf:baseline": "node tools/performance/run.mjs",
    "perf:test": "node --test tools/performance/*.test.js"
  },
  "dependencies": {
    "playcanvas": "^2.23.3"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "3.10.3",
    "playwright-core": "1.65.0",
    "vite": "^8.3.5"
  }
}
